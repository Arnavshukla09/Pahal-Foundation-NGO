# ============================================================
# Pahal Foundation — Environment Variables Template
# ============================================================
# Copy this file as `.env` locally, or paste these keys into
# Vercel → Project Settings → Environment Variables
# ============================================================

# Django
DJANGO_SECRET_KEY=your-very-long-random-secret-key-here
DEBUG=False

# MySQL Database (Aiven or any cloud MySQL)
DB_HOST=your-database-host.aivencloud.com
DB_NAME=pahaldb
DB_USER_ROOT=avnadmin
DB_PASSWORD_ROOT=your-database-password
DB_PORT=12727

# AWS S3 (for media files: student/volunteer photos, blog images)
AWS_ACCESS_KEY_ID=your-aws-access-key-id
AWS_SECRET_ACCESS_KEY=your-aws-secret-access-key
AWS_STORAGE_BUCKET_NAME=your-s3-bucket-name

# Razorpay Payment Gateway
RAZORPAY_API_KEY=rzp_live_xxxxxxxxxxxx
RAZORPAY_API_SECRET=your-razorpay-secret
